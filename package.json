{
  "name": "ziko-lecolo",
  "private": true,
  "version": "0.1.0",
  "description": "Ziko l'écolo — jeu de plateau 2D (Phaser + TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "simulate": "vite-node tools/simulate.ts",
    "screens": "npm run build && vite-node tools/screens.ts"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.0"
  }
}
